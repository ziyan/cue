/build
/dist

# A stray "go build ./tools/<name>" writes its binary into the working
# directory under that name, and one of them was committed. The Makefile
# builds into /build; nothing should produce a binary here.
/changelog
/checkpackages
/checksecrets
/cue
/deploy-tool
/release
/smoke

# Local tooling state. Nothing here belongs to the project; it belongs to
# whoever is working on it. Named explicitly because the first commit of a
# fresh repository is made with "git add -A".
/.claude/

# Development state: a generated configuration, an X authority cookie, a
# browser profile. None of it is reproducible and some of it is secret.
/dev/

build/
probe

# The built interface. Made by `make web`, from web/. Not committed: it is
# derived, it is large, and a stale one in a diff tells nobody anything.
# The directory itself stays, with a .gitkeep, because internal/web embeds it
# and an embed of a directory that does not exist will not compile.
/internal/web/dist/*
!/internal/web/dist/.gitkeep
/web/node_modules/
